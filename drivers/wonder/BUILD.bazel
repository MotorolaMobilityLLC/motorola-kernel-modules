# Google Wonder WiFi Virtual Device driver.

load("//soc-repo:kleaf-scripts/moto/moto_modules_define.bzl", "moto_ddk_module")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

exports_files(["Kconfig"])

moto_ddk_module(
    name = "wonder",
    srcs = glob([
        "**/*.h",
    ]) + [
        "band_config.c",
        "mac80211.c",
        "mac80211_txs.c",
        "main.c",
        "nl80211_ven_cmd.c",
        "ssr.c",
        "wondertap.c",
    ],
    deps_ext = [
        "//soc-repo:net/wireless/cfg80211",
        "//soc-repo:net/mac80211/mac80211",
    ],

    conditional_srcs = {
        "CONFIG_DEBUG_FS": {
            True: [
                "debugfs.c",
            ],
        },
    },
)

ddk_headers(
    name = "wonder_headers",
    hdrs = glob([
        "include/**/*.h",
    ]) + [
        "Makefile.include",
    ],
    includes = [
        "include",
    ],
    visibility = [
        # keep sorted
        "//visibility:public"
    ],
)

