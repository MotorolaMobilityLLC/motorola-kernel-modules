load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ko(
    name = "moto_sched",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "Kbuild",
        "Makefile",
    ]) + select({
        "//build/bazel_mgk_rules:kernel_version_6.1"     : ["//kernel_device_modules-6.1:mtk_public_headers"],
        "//build/bazel_mgk_rules:kernel_version_6.6"     : ["//kernel_device_modules-6.6:mtk_public_headers"],
        "//conditions:default"                           : [],
    }),
)

filegroup(
    name = "sched_headers",
    srcs = glob([
        "*.h",
    ]),
)
