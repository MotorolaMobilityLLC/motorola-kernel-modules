load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")
load(":kernel_helpers.bzl", "get_kernel_headers")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ko(
    name = "moto_sched",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "Kbuild",
        "Makefile",
    ]) + get_kernel_headers(),
)

filegroup(
    name = "sched_headers",
    srcs = glob([
        "*.h",
    ]),
)
