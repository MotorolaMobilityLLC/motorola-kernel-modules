ifneq ($(findstring _factory,$(TARGET_PRODUCT)),)
USE_TARGET_PRODUCT := $(strip $(subst _factory,, $(TARGET_PRODUCT)))
else
USE_TARGET_PRODUCT := $(TARGET_PRODUCT)
endif

ifeq ($(TARGET_PRODUCT),)
USE_TARGET_PRODUCT := $(CONFIG_MTK_PROJECT_NAME)
$(warning "USE_TARGET_PRODUCT = $(USE_TARGET_PRODUCT)")
endif

ifneq ($(filter bangkk%, $(USE_TARGET_PRODUCT)), )
        EXTRA_CFLAGS += -DPRODUCT_BANGKK
else ifneq ($(filter avatrn%, $(USE_TARGET_PRODUCT)), )
        EXTRA_CFLAGS += -DPRODUCT_AVATRN
else ifneq ($(filter scout%, $(USE_TARGET_PRODUCT)), )
        EXTRA_CFLAGS += -DPRODUCT_SCOUT
else ifneq ($(filter cybert%, $(USE_TARGET_PRODUCT)), )
        EXTRA_CFLAGS += -DPRODUCT_CYBERT
else ifneq ($(filter fuji%, $(USE_TARGET_PRODUCT)), )
        EXTRA_CFLAGS += -DPRODUCT_FUJI
else ifneq ($(filter naples%, $(USE_TARGET_PRODUCT)), )
        EXTRA_CFLAGS += -DPRODUCT_NAPLES
endif

$(warning "focalteh EXTRA_CFLAGS = $(EXTRA_CFLAGS)")

