focaltech_touch_v3_u_mmi-objs += focaltech_flash.o
focaltech_touch_v3_u_mmi-objs += focaltech_spi.o
focaltech_touch_v3_u_mmi-objs += focaltech_test/focaltech_test.o
focaltech_touch_v3_u_mmi-objs += focaltech_test/focaltech_test_ini.o
focaltech_touch_v3_u_mmi-objs += focaltech_ts_config.o
focaltech_touch_v3_u_mmi-objs += focaltech_debug.o

ifneq ($(filter ft3681,$(CONFIG_FOCALTECH_TOUCH_IC_NAME)),)
	EXTRA_CFLAGS += -DCONFIG_FTS_IC_FT3681
	focaltech_touch_v3_u_mmi-objs += focaltech_flash/focaltech_upgrade_ft3681.o
	focaltech_touch_v3_u_mmi-objs += focaltech_test/supported_ic/focaltech_test_ft3681.o
endif

ifneq ($(filter ft3683g,$(CONFIG_FOCALTECH_TOUCH_IC_NAME)),)
	EXTRA_CFLAGS += -DCONFIG_FTS_IC_FT3683G
	EXTRA_CFLAGS += -DCONFIG_FTS_NOISE_TEST_P2P
	focaltech_touch_v3_u_mmi-objs += focaltech_flash/focaltech_upgrade_ft3683g.o
	focaltech_touch_v3_u_mmi-objs += focaltech_test/supported_ic/focaltech_test_ft3683g.o
endif

ifneq ($(filter m y,$(CONFIG_FTS_INPUT_PROTOCOL_V0)),)
	EXTRA_CFLAGS += -DCONFIG_FTS_INPUT_PROTOCOL_V0
endif

ifneq ($(filter m y,$(CONFIG_INPUT_TOUCHSCREEN_MMI)),)
       EXTRA_CFLAGS += -DCONFIG_INPUT_TOUCHSCREEN_MMI
       focaltech_touch_v3_u_mmi-objs += focaltech_ts_mmi.o
endif
ifneq ($(filter m y,$(CONFIG_INPUT_FOCALTECH_V3_MMI_ENABLE_DOUBLE_TAP)),)
	EXTRA_CFLAGS += -DFOCALTECH_SENSOR_EN
