ifneq ($(filter m y, $(CONFIG_MTK_PANEL_NOTIFICATIONS)),)
        EXTRA_CFLAGS += -DCONFIG_MTK_PANEL_NOTIFICATIONS
        EXTRA_CFLAGS += -DCFG_MTK_PANEL_NOTIFIER
